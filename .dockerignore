# Build context for containers/toon/Containerfile is the repo root; only
# backend/ and frontend/ (without dependencies and build artifacts) go to
# the build, plus dev/seed.py as the demo seed of a preview.
# Named .dockerignore because the compose provider (docker-compose) only
# reads that name; podman build reads it too.
.git
.github
actions
artifacts
cli
db
dev
!dev/seed.py
docs
e2e
skills
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.tsbuildinfo
frontend/dist
frontend/coverage
