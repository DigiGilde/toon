# syntax=docker/dockerfile:1
# Builds the whole product image: backend plus the built admin SPA. Build
# context is the repo root (dev/compose.yml: context ".."), because the
# image bundles the built admin SPA from frontend/ alongside the backend.
FROM docker.io/library/node:25-trixie-slim@sha256:aabbe39553d15ede8a97cc60c9e1a97034ff772afcf696ea42b94e7f5f2ec71b AS spa

WORKDIR /spa

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

ARG TOON_VERSION=dev
COPY frontend/ ./
RUN TOON_VERSION="${TOON_VERSION}" npm run build

FROM ghcr.io/astral-sh/uv:0.13-python3.15-trixie-slim@sha256:1017e944d8b320412287a572b8221cda45742348d0feb99e500f1f4c4b019206 AS build

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project

COPY backend/src ./src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

FROM docker.io/library/python:3.15-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS runtime

# The zlib1g upgrade patches CVE-2026-76844 and CVE-2026-85091 until the
# upstream image carries 1:1.3.dfsg+really1.3.1-1+deb13u1; it can go when the
# FROM pin moves past it.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends --only-upgrade zlib1g \
    && rm -rf /var/lib/apt/lists/*

# The app runs from the venv uv built, so pip is not needed here, and pip
# 26.2.2 vendors urllib3, msgpack and setuptools with HIGH advisories. The CI
# scan of this base image skips pip's directory to match (ci.yml).
RUN python -m pip uninstall --yes --quiet pip

RUN groupadd --system --gid 1000 toon \
    && useradd --system --uid 1000 --gid toon --no-create-home toon \
    # /content/_tmp pre-created in the image: rootless Podman chowns an EMPTY
    # named volume on every container start to that image's mountpoint owner.
    # Copy-up of this non-empty directory on the first app mount keeps the
    # volume non-empty and thus owned by toon.
    && mkdir -p /content/_tmp \
    && chown -R toon:toon /content

WORKDIR /app

COPY --from=build --chown=toon:toon /app/.venv /app/.venv
COPY --from=build --chown=toon:toon /app/src /app/src
COPY --from=spa --chown=toon:toon /spa/dist /app/spa
COPY --chown=toon:toon backend/alembic ./alembic
COPY --chown=toon:toon backend/alembic.ini ./alembic.ini
# 555, not 755: the file is read and executed, never written, and the user
# that runs it does not own it.
COPY --chown=toon:toon --chmod=555 containers/toon/entrypoint.sh ./entrypoint.sh

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    TOON_SPA_PATH=/app/spa

ARG TOON_VERSION=dev
LABEL org.opencontainers.image.version=${TOON_VERSION}

# Numeric: the kubelet cannot verify runAsNonRoot for a user name.
USER 1000:1000

EXPOSE 8080

# The entrypoint migrates and then execs uvicorn; the --no-access-log that
# keeps secret links (?key=...) out of the log stack lives there now
# (docs/security.md).
CMD ["./entrypoint.sh"]
