{
  "name": "toon-frontend",
  "version": "2026.11.20",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && vite build -c vite.widget.config.ts && vite build -c vite.place.config.ts && vite build -c vite.editor.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b --noEmit",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@nldd/design-system": "0.26.5",
    "html-to-image": "1.11.13",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.3"
    },
    "editorconfig": {
      "minimatch": "^11.0.3"
    }
  }
}
