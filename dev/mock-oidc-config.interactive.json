{
  "interactiveLogin": true,
  "loginPagePath": "/app/mock-oidc-login.html",
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "subject",
          "match": "*",
          "claims": {
            "sub": "${subject}",
            "acr": "http://eidas.europa.eu/LoA/substantial",
            "email_verified": true
          }
        }
      ]
    }
  ]
}
